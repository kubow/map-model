<wpt lat="40.636175" lon="17.938991">
  <ele>0</ele>
  <name>Brindisi</name>
  <desc>&lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA272&amp;amp;hl=cs&amp;amp;vq=%22Brindisi%22&quot;&gt;Strana 272&lt;/a&gt;&lt;br&gt;crossed the Alps at Saint Gotthard Pass, and like a swarm of dying locusts surged down the Italian coast through Ancona as far as &lt;b&gt;Brindisi&lt;/b&gt; in the heel &lt;b&gt;...&lt;/b&gt;&lt;br&gt;more pages:  &lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA272&amp;amp;hl=cs&amp;amp;vq=%22Brindisi%22&quot;&gt;Strana 272&lt;/a&gt;</desc>
