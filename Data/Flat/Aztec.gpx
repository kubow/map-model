<wpt lat="52.202544" lon="0.131236">
  <ele>0</ele>
  <name>Cambridge</name>
  <desc>&lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA141&amp;amp;hl=cs&amp;amp;vq=%22Cambridge%22&quot;&gt;Strana 141&lt;/a&gt;&lt;br&gt;making more progress than the professionals, and some of his notes were handed along to a young &lt;b&gt;Cambridge&lt;/b&gt; philologist, John Chadwick. &lt;b&gt;...&lt;/b&gt;&lt;br&gt;more pages:  &lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA141&amp;amp;hl=cs&amp;amp;vq=%22Cambridge%22&quot;&gt;Strana 141&lt;/a&gt;</desc>
