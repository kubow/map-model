<wpt lat="4.96" lon="8.31">
  <ele>0</ele>
  <name>Calabar</name>
  <desc>&lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA239&amp;amp;hl=cs&amp;amp;vq=%22Calabar%22&quot;&gt;Strana 239&lt;/a&gt;&lt;br&gt;visited the Fjort tribe along the Congo, then marched and paddled in a northerly direction until she emerged at the old city of &lt;b&gt;Calabar&lt;/b&gt;. &lt;b&gt;...&lt;/b&gt;&lt;br&gt;more pages:  &lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA239&amp;amp;hl=cs&amp;amp;vq=%22Calabar%22&quot;&gt;Strana 239&lt;/a&gt;</desc>
