  <ele>0</ele>
  <name>Dawlatabad</name>
  <desc>&lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA234&amp;amp;hl=cs&amp;amp;vq=%22Dawlatabad%22&quot;&gt;Strana 234&lt;/a&gt;&lt;br&gt;mangonel &#x2014; a military device ordinarily used for catapulting stones &#x2014; and a blind man whom the sultan ordered to be dragged from Delhi to &lt;b&gt;Dawlatabad&lt;/b&gt;. &lt;b&gt;...&lt;/b&gt;&lt;br&gt;more pages:  &lt;a href=&quot;http://books.google.com/books?id=BKpZAAAAMAAJ&amp;amp;pg=PA234&amp;amp;hl=cs&amp;amp;vq=%22Dawlatabad%22&quot;&gt;Strana 234&lt;/a&gt;</desc>
